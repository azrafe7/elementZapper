{
  "manifest_version": 3,
  "name": "Element Zapper (Clean Architecture Demo)",
  "version": "1.0.0",
  "description": "Test build using the new clean message-passing architecture.",
  "permissions": ["scripting", "activeTab"],
  "background": {
    "service_worker": "background/router.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/messaging.js",
        "shared/send.js",
        "content/router.js",
        "content/zapper.js"
      ],
      "css": ["content/styles.css"]
    }
  ]
}
